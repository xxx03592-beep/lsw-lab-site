{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mhi-clone (Windows)",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "serve.ps1", "5173"],
      "port": 5173
    },
    {
      "name": "mhi-clone (Mac/Linux)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5173", "--bind", "127.0.0.1"],
      "port": 5173
    }
  ]
}
