// Cloudflare Workers config for leeframes.com (deployed by Workers Builds on every push to master).
// The site is static files at the repo root, served as assets; worker.js only handles /api/*.
// Files that must not be public are listed in .assetsignore.
{
  "name": "lsw-lab-site", // must match the Worker's name in the Cloudflare dashboard
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Quote form email (worker.js): uncomment once leeframes.com is onboarded to Cloudflare
  // Email Sending (Email Routing on, a verified address). Until then /api/quote answers 503.
  // "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
